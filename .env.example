# Clock (Healthchecks.io ping URL for one check)
HC_PING_URL=https://hc-ping.com/your-uuid

# Telegram bot for /alive /status /dead-now /abort
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra nudge
NTFY_URL=https://ntfy.sh/your-unpredictable-topic

# Webhook the clock calls on DOWN
DMM_WEBHOOK_SECRET=change-me
DMM_ABORT_TOKEN=change-me-too

# Executor
DMM_DRY_RUN=true
# AGE_IDENTITY_FILE=/data/executor.agekey

# Optional brain / depot (not needed for core)
# OPENAI_BASE_URL=http://new-api:3000/v1
# OPENAI_API_KEY=sk-newapi-executor-token
